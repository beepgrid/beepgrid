# Local development. Production configuration is documented in docs/OPERATIONS.md.
BEEPGRID_DATABASE_URL=postgres://beepgrid:beepgrid@localhost:5499/beepgrid?sslmode=disable
BEEPGRID_SCHEMA=beepgrid
BEEPGRID_ADDR=127.0.0.1:4010
BEEPGRID_PUBLIC_URL=http://localhost:4010
BEEPGRID_WORKSPACE=local
BEEPGRID_ENVIRONMENT=development
BEEPGRID_COMPANY=Local workspace
BEEPGRID_ATTACHMENTS_DIR=.local/attachments
# --dev generates protected local files. Production requires protected values.
BEEPGRID_BOOTSTRAP_TOKEN=
# Exactly 64 hexadecimal characters. Preserve with backups; do not rotate casually.
BEEPGRID_SECRET_KEY=
# Optional OIDC; callback is /auth/oidc/callback. Login does not import a directory.
BEEPGRID_OIDC_ISSUER=
BEEPGRID_OIDC_CLIENT_ID=
BEEPGRID_OIDC_CLIENT_SECRET=
# Optional provider-neutral overseer endpoint. Both assistance features default to off.
BEEPGRID_OVERSEER_URL=
BEEPGRID_OVERSEER_TOKEN=
# SDK/MCP/CLI client configuration. Never supply an owner token to a frontend.
BEEPGRID_URL=http://localhost:4010
BEEPGRID_TOKEN=
# Optional MCP automatic enrollment using a namespace-restricted launcher token.
BEEPGRID_AGENT_ID=
BEEPGRID_AGENT_NAME=

# Optional automatic informational answer matching. Enabling still requires the owner toggle.

# Optional built-in AI. Choose the provider AND model explicitly; neither has a default.
# Providers: openai, anthropic, google, openai-compatible. Native API credentials
# belong here on the server only. Compatible local endpoints may omit the key.
BEEPGRID_AI_PROVIDER=
BEEPGRID_AI_MODEL=
BEEPGRID_AI_API_KEY=
# Base URL, including its API version path. Required for openai-compatible.
BEEPGRID_AI_BASE_URL=
# Optional JSON generation controls, documented in docs/ASSISTANCE.md.
BEEPGRID_AI_OPTIONS=
# schema/json/text. Defaults: schema for native APIs, json for compatible APIs.
BEEPGRID_AI_OUTPUT_MODE=
# Explicitly allow HTTP/private addresses for this AI endpoint only (for local inference).
BEEPGRID_AI_ALLOW_PRIVATE=
