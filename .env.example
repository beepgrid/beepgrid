# Local development. Production configuration is documented in docs/OPERATIONS.md.
NOTIF_DATABASE_URL=postgres://notif:notif@localhost:5499/notif?sslmode=disable
NOTIF_SCHEMA=notif
NOTIF_ADDR=127.0.0.1:4010
NOTIF_PUBLIC_URL=http://localhost:4010
NOTIF_WORKSPACE=local
NOTIF_ENVIRONMENT=development
NOTIF_COMPANY=Local workspace
NOTIF_ATTACHMENTS_DIR=.local/attachments
# --dev generates protected local files. Production requires protected values.
NOTIF_BOOTSTRAP_TOKEN=
# Exactly 64 hexadecimal characters. Preserve with backups; do not rotate casually.
NOTIF_SECRET_KEY=
# Optional OIDC; callback is /auth/oidc/callback. Login does not import a directory.
NOTIF_OIDC_ISSUER=
NOTIF_OIDC_CLIENT_ID=
NOTIF_OIDC_CLIENT_SECRET=
# Optional customer-operated semantic match endpoint. Core delivery works without it.
NOTIF_MATCHER_URL=
NOTIF_MATCHER_TOKEN=
# SDK/MCP/CLI client configuration. Never supply an owner token to a frontend.
NOTIF_URL=http://localhost:4010
NOTIF_TOKEN=
# Optional MCP automatic enrollment using a namespace-restricted launcher token.
NOTIF_AGENT_ID=
NOTIF_AGENT_NAME=
