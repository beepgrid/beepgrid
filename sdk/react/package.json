    "react": ">=19"
  },
  "devDependencies": {
    "@beepgrid/sdk": "file:../typescript",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^27.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "sideEffects": [
