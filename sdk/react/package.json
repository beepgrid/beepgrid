{
  "name": "@beepgrid/react",
  "version": "0.2.1",
  "description": "Authenticated request and conversation components for Beepgrid",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
