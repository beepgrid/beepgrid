          },
          {
            "$ref": "#/components/schemas/Agent"
          },
          {
            "$ref": "#/components/schemas/Service"
          }
        ]
      },
      "service": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Person"
          },
          {
            "$ref": "#/components/schemas/Agent"
          },
          {
            "$ref": "#/components/schemas/Service"
          }
        ]
      },
      "instance_id": {
        "type": "string",
        "description": "Current exact runtime ID, or empty for a non-runtime credential."
      },
      "admin": {
        "type": "boolean",
        "description": "Whether the actual credential has administrator authority."
      },
      "can_publish_answers": {
        "type": "boolean",
        "description": "Current answer-publication capability."
      },
      "company": {
        "type": "string",
        "description": "Workspace display name."
      },
      "environment": {
        "type": "string",
        "description": "Environment label."
      }
    }
  },
  "POST /api/v1/fleet/status": {
    "type": "object",
    "properties": {
      "agents": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "agent": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/Person"
                },
                {
                  "$ref": "#/components/schemas/Agent"
                },
                {
                  "$ref": "#/components/schemas/Service"
                }
              ]
            },
            "instances": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/Instance"
              },
              "description": "Visible runtime observations."
            },
            "fresh": {
              "type": "boolean",
              "description": "At least one valid runtime is currently connected."
            }
          }
        },
        "description": "At most 100 selected/visible agents."
      },
      "deadlocks": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "dependencies": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "request_id": {
                    "type": "string",
                    "description": "Explicitly blocking open request."
                  },
                  "conversation_id": {
                    "type": "string",
                    "description": "Its current authorized history."
                  },
                  "from": {
                    "oneOf": [
                      {
                        "$ref": "#/components/schemas/Person"
                      },
                      {
                        "$ref": "#/components/schemas/Agent"
                      },
                      {
                        "$ref": "#/components/schemas/Service"
                      }
                    ]
                  },
                  "to": {
                    "oneOf": [
                      {
                        "$ref": "#/components/schemas/Person"
                      },
                      {
                        "$ref": "#/components/schemas/Agent"
                      },
                      {
                        "$ref": "#/components/schemas/Service"
                      }
                    ]
                  }
                }
              },
              "description": "Explicit blocking-request edges in this cycle."
            }
          }
        },
        "description": "Currently visible communication cycles."
      },
      "total": {
        "type": "integer",
        "description": "Number of included agents."
      },
      "fresh": {
        "type": "integer",
        "description": "Number with a connected instance."
      },
      "missing_or_stale": {
        "type": "integer",
        "description": "Number without a currently connected instance."
      },
      "as_of": {
        "type": "string",
        "description": "Observation time.",
        "format": "date-time"
      },
      "summary": {
        "type": "string",
        "description": "Human-readable presence summary."
      },
      "mode": {
        "type": "string",
        "description": "read_only."
      },
      "commands_supported": {
        "type": "boolean",
        "description": "False; this endpoint does not dispatch work."
      }
    }
  },
