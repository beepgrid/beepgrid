      },
      "can_read_account": {
        "type": "boolean",
        "description": "Whether this caller may inspect the account projection."
      }
    }
  },
  "GET /api/v1/workspace/account": {
    "type": "object",
    "properties": {
      "scope": {
        "type": "string",
        "description": "Selected workspace scope ID."
      },
      "company": {
        "type": "string",
        "description": "Workspace display name."
      },
      "environment": {
        "type": "string",
        "description": "Selected environment label."
      },
      "can_read_account": {
        "type": "boolean",
        "description": "Whether this caller may inspect the account projection."
      },
      "suspended": {
        "type": "boolean",
        "description": "Whether the workspace is suspended."
      },
      "recovery_hold": {
        "type": "boolean",
        "description": "Whether restore reconciliation holds outbound work."
      },
      "access_until": {
        "type": "string",
        "description": "Optional access cutoff.",
        "format": "date-time"
      },
      "control_version": {
        "type": "integer",
        "description": "Applied control revision."
      },
      "budget": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "description": "Applied budget revision."
          },
          "messages": {
            "type": "integer",
            "description": "Monthly canonical recipient-message allowance; -1 means unlimited."
          },
          "requests": {
            "type": "integer",
            "description": "Monthly requested-reply allowance; -1 means unlimited."
          },
          "upload_bytes": {
            "type": "integer",
            "description": "Monthly accepted-upload byte allowance; -1 means unlimited."
          }
        },
        "description": "Applied runtime budget, or null when none is configured."
      },
      "usage": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "period": {
              "type": "string",
              "description": "UTC month boundary.",
              "format": "date-time"
            },
            "metric": {
              "type": "string",
              "description": "Counted usage category."
            },
            "units": {
              "type": "integer",
              "description": "Recorded canonical units."
            }
          }
        },
        "description": "Recorded usage, not provider attempts or CPU/memory."
      },
      "metered": {
        "type": "boolean",
        "description": "Whether an applied budget is configured."
      },
      "source": {
        "type": "string",
        "description": "applied_runtime for the OSS store; a configured account bridge may supply its own source."
      }
    }
  },
  "POST /api/v1/dispatch-preview": {
    "type": "object",
    "properties": {
      "recipients": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "target": {
              "$ref": "#/components/schemas/Target"
            },
            "name": {
              "type": "string",
              "description": "Visible recipient display name."
            },
            "routes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "description": "Connection/provider kind."
                  },
                  "mode": {
                    "type": "string",
                    "description": "Destination routing mode."
                  },
                  "enabled": {
                    "type": "boolean",
                    "description": "Connection enabled state."
                  },
                  "permitted": {
                    "type": "boolean",
                    "description": "Current policy result."
                  },
                  "reason": {
                    "type": "string",
                    "description": "Reason for the routing result."
                  }
                }
              },
              "description": "Permitted and rejected visible routes."
            }
          }
        },
        "description": "Recipients visible to this caller."
      },
      "count": {
        "type": "integer",
        "description": "Total eligible recipient count."
      },
      "hidden_recipients": {
        "type": "integer",
        "description": "Recipient count whose metadata is not disclosed."
      },
      "token": {
        "type": "string",
        "description": "Short-lived audience/route fingerprint for the matching write."
      },
      "expires_at": {
        "type": "string",
        "description": "Token expiry.",
        "format": "date-time"
      },
      "sends": {
        "type": "boolean",
        "description": "Always false; preview does not dispatch."
      }
    }
  },
  "POST /api/v1/route-preview": {
    "type": "object",
    "properties": {
      "recipients": {
        "type": "array",
        "items": {
          "oneOf": [
            {
              "$ref": "#/components/schemas/Person"
            },
            {
              "$ref": "#/components/schemas/Agent"
            },
            {
              "$ref": "#/components/schemas/Service"
            }
          ]
        },
        "description": "Visible resolved recipients."
      },
      "count": {
        "type": "integer",
        "description": "Total eligible recipients."
      },
      "hidden_recipients": {
        "type": "integer",
        "description": "Eligible recipients whose metadata is hidden."
      },
      "mode": {
        "type": "string",
        "description": "private_per_recipient."
      },
      "sends": {
        "type": "boolean",
        "description": "Always false."
      }
    }
  },
  "GET /api/v1/requests/{id}/trace": {
    "type": "object",
    "properties": {
      "request": {
        "$ref": "#/components/schemas/Request"
      },
      "deliveries": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {},
            "description": "Authorized records returned by this page."
          },
          "next_cursor": {
            "type": "string",
            "description": "Opaque next-page cursor. Continue even when the current items array is empty."
          },
          "order": {
            "type": "string",
            "description": "Documented ordering for this collection."
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "executions": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {},
            "description": "Authorized records returned by this page."
          },
          "next_cursor": {
            "type": "string",
            "description": "Opaque next-page cursor. Continue even when the current items array is empty."
          },
          "order": {
            "type": "string",
            "description": "Documented ordering for this collection."
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "evidence": {
        "type": "string",
        "description": "Explains transport versus executor-reported business evidence."
      }
    }
  },
  "POST /api/v1/roles/preview": {
    "type": "object",
    "properties": {
      "can_save": {
        "type": "boolean",
        "description": "Whether current authority permits this proposal."
      },
      "version": {
        "type": "integer",
        "description": "Current role revision."
      },
      "affected_assignments": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Binding"
        },
        "description": "Existing bindings affected by this role."
      },
      "checks": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "check": {
              "type": "object",
              "properties": {
                "subject_id": {
                  "type": "string",
                  "description": "Principal whose effective grants are simulated."
                },
                "action": {
                  "type": "string",
                  "description": "Permission action."
                },
                "target": {
                  "$ref": "#/components/schemas/Target"
                },
                "connection_id": {
                  "type": "string",
                  "description": "Optional route condition."
                },
                "action_name": {
                  "type": "string",
                  "description": "Optional business action name."
                },
                "descriptor": {
                  "$ref": "#/components/schemas/Action"
                }
              }
            },
            "before": {
              "type": "boolean",
              "description": "Current effective permission."
            },
            "after": {
              "type": "boolean",
              "description": "Effective permission under the proposed role."
            }
          }
        },
        "description": "Bounded permission comparisons."
      },
      "basis": {
        "type": "string",
        "description": "effective_role_grants; administrator bypass is excluded from simulation."
      },
      "saves": {
        "type": "boolean",
        "description": "Always false."
      }
    }
  },
  "GET /api/v1/me": {
    "type": "object",
    "properties": {
      "identity_type": {
        "type": "string",
