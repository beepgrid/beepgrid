  "GET /api/v1/workspace": {
    "type": "object",
    "properties": {
      "scope": {
        "type": "string",
        "description": "Selected workspace scope ID."
      },
      "company": {
        "type": "string",
        "description": "Workspace display name."
      },
      "environment": {
        "type": "string",
